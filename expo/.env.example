# Expo exposes EXPO_PUBLIC_* values in the client bundle. Do not put secrets here.
# Web and iOS Simulator can reach a locally running API through localhost.
EXPO_PUBLIC_API_BASE_URL=http://localhost:3310/api/v1

# For an Android Emulator, copy this file to .env and use instead:
# EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:3310/api/v1

# For a physical device, use the development computer's LAN address instead:
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.100:3310/api/v1
