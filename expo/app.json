{
  "expo": {
    "name": "DYNAMIC Field App",
    "slug": "dynamic-field-app",
    "version": "0.1.0",
    "icon": "./assets/images/icon.png",
    "orientation": "portrait",
    "platforms": [
      "web",
      "ios",
      "android"
    ],
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow DYNAMIC to use Face ID to unlock the field app after login."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow DYNAMIC to scan admin-issued login QR codes."
        }
      ],
      "expo-sqlite"
    ],
    "android": {
      "package": "com.drguptavivek.dynamicfieldapp"
    }
  }
}
