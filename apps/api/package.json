{
  "name": "@dynamic/api",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "test:integration": "npm run db:test:migrate && DATABASE_URL=${TEST_DATABASE_URL:-postgresql://dynamic:dynamic_dev_password@localhost:55432/dynamic_test} JWT_SECRET=test_jwt_secret JWT_REFRESH_SECRET=test_refresh_secret tsx --test \"src/**/*.integration.ts\"",
    "build": "tsc --project tsconfig.json",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "start": "node dist/index.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:test:ensure": "tsx src/dev/ensure-test-db.ts",
    "db:test:migrate": "npm run db:test:ensure && DATABASE_URL=${TEST_DATABASE_URL:-postgresql://dynamic:dynamic_dev_password@localhost:55432/dynamic_test} drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "smoke:dev": "tsx src/dev/smoke-dev.ts",
    "seed:large": "tsx src/dev/large-field-seed.ts"
  },
  "dependencies": {
    "@dynamic/shared-domain": "*",
    "@dynamic/shared-workflow": "*",
    "@types/express": "^4.17.21",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.31.2",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.1.1",
    "pg": "^8.11.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^2.1.0",
    "@types/node": "^20.0.0",
    "@types/pg": "^8.11.6",
    "drizzle-kit": "^0.22.7",
    "tsx": "^4.11.0",
    "typescript": "^5.4.5"
  }
}
