DATABASE_URL=postgresql://dynamic:dynamic_dev_password@localhost:55432/dynamic_dev
TEST_DATABASE_URL=postgresql://dynamic:dynamic_dev_password@localhost:55432/dynamic_test
JWT_SECRET=change_me_in_production
JWT_REFRESH_SECRET=change_me_in_production_refresh
PORT=3310
NODE_ENV=development
# SMTP credentials are production-only secrets. Set these in the AWS service
# environment (for example /etc/dynamic/api.env), never in Git.
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=mailer@example.com
SMTP_PASSWORD=replace-in-aws-only
SMTP_FROM=mailer@example.com
