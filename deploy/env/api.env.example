# Copy to /etc/dynamic/api.env; chmod 600 and chown dynamic-api:dynamic-api.
NODE_ENV=production
APP_ENV=production
PORT=3310
DATABASE_URL=postgresql://dynamic_app:URL_ENCODED_PASSWORD@127.0.0.1:5432/dynamic
REDIS_URL=redis://:URL_ENCODED_REDIS_PASSWORD@127.0.0.1:6379
JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_REFRESH_SECRET=replace-with-a-different-at-least-32-random-bytes
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_MS=900000
