[Unit]
Description=DYNAMIC production Docker services (PostgreSQL, Redis, Nginx)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
RequiresMountsFor=/data
ConditionPathIsMountPoint=/data

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/data/dynamic/current/deploy
ExecStart=/usr/bin/docker compose -f /data/dynamic/current/deploy/docker-compose.production.yml --env-file /etc/dynamic/production.env up -d postgres redis nginx
ExecStop=/usr/bin/docker compose -f /data/dynamic/current/deploy/docker-compose.production.yml --env-file /etc/dynamic/production.env stop nginx redis postgres
TimeoutStartSec=180
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
